# Doxygen configuration of the C version.  `doxygen Doxyfile` writes the HTML
# to doc-c/html and fails on a warning: a struct, a member of a struct, a
# function, a variable, a macro or a type without a comment.  CI runs it (the
# job doc-c).
#
# Only the files whose copyright is Damien Miller or Hitoshi Irino are read:
# convtime.c, convtime.h and daemon.c come from OpenBSD and have no Doxygen
# comments, and neither do the files of compat/.  The C++ version in cpp/ and
# the Rust version have their own documentation.
PROJECT_NAME           = "softflowd"
OUTPUT_DIRECTORY       = doc-c
INPUT                  = common.h \
                         export.c \
                         export_common.c \
                         export_common.h \
                         format.c \
                         format.h \
                         freelist.c \
                         freelist.h \
                         globals.h \
                         ipfix.h \
                         ipfix_fields.h \
                         log.c \
                         log.h \
                         netflow.h \
                         netsock.c \
                         netsock.h \
                         ntopng.c \
                         options.c \
                         options.h \
                         psamp.c \
                         psamp.h \
                         sender.c \
                         sender.h \
                         softflowctl.c \
                         softflowd.c \
                         softflowd.h \
                         treetype.h
EXTRACT_STATIC         = YES
# KEY_ADD is a macro that softflowd.c defines inside a function, where Doxygen
# cannot attach a comment to it.
EXCLUDE_SYMBOLS        = KEY_ADD
ENABLE_PREPROCESSING   = YES
# Only the macros named in PREDEFINED are expanded: the attributes, and the
# macros that define a function or generate the code of a tree, which Doxygen
# would take for a function or a variable of a strange name.
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
# The code that configure switches on, so that it is checked too: the threads,
# ntopng and the interface name; and the default exporter (COMPAT_EXPORT 0,
# not the compat one of the sentinels 1 and 2).
PREDEFINED             = ENABLE_PTHREAD ENABLE_NTOPNG ENABLE_IFNAME \
                         COMPAT_EXPORT=0 COMPAT_EXPORT_STATIC=1 \
                         COMPAT_EXPORT_STATIC_SEPARATE=2 \
                         "__packed=" "__attribute__(x)=" \
                         "EXPORT_ENC_HTON(a,b,c)=" "EXPORT_ENC_COPY(a,b,c)=" \
                         "EXPORT_ENC_BYTE(a,b)=" \
                         "FLOW_PROTOTYPE(a,b,c,d)=" "FLOW_GENERATE(a,b,c,d)=" \
                         "EXPIRY_PROTOTYPE(a,b,c,d)=" "EXPIRY_GENERATE(a,b,c,d)="
# No Graphviz: newer Doxygen (1.15) tries to run dot unless it is told not to,
# and a runner without Graphviz would fail.
HAVE_DOT               = NO
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = FAIL_ON_WARNINGS
